+import { NativeModules, TurboModuleRegistry } from 'react-native';
 import type { OrtApi as OrtApiType } from './api';
 
-export const Module = NativeModules.Onnxruntime;
+// Bridgeless New Architecture exposes legacy bridge modules only through the
+// TurboModule legacy-interop proxy (global.__turboModuleProxy). NativeModules.Onnxruntime
+// is `null` under bridgeless, so resolving it directly crashes with
+// "Cannot read property 'install' of null" at import time. TurboModuleRegistry.get tries
+// the interop proxy first and falls back to NativeModules, so it works on both architectures.
+export const Module = TurboModuleRegistry.get('Onnxruntime') ?? NativeModules.Onnxruntime;
 
